# ---------------------------------------------------------------------------
# Employee Management - environment configuration
# Copy to .env and adjust. `docker compose --env-file .env up -d --build`
# ---------------------------------------------------------------------------

# Postgres
DB_NAME=emp_mgmt
DB_USERNAME=emp_mgmt
DB_PASSWORD=emp_mgmt
POSTGRES_PORT=5432

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# !! REQUIRED !! Use a long random string (at least 32 chars) in any real deployment
APP_JWT_SECRET=change-me-development-secret-at-least-32-chars-long
APP_JWT_EXPIRATION_MS=86400000

# Application timezone used for "today"/date-only values
APP_TIMEZONE=UTC

# Comma separated list of allowed CORS origins
APP_CORS_ORIGINS=http://localhost,http://localhost:5173

# Seed demo data on first boot (admin + sample employees). Disable in production.
APP_SEED_ENABLED=false

# Weekly off days (ISO: 1=Mon .. 7=Sun)
APP_WEEKLY_OFFS=6,7
APP_EXCLUDE_WEEKENDS=true
APP_EXCLUDE_HOLIDAYS=true